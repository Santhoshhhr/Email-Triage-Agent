   "source": [
    "import os\n",
    "import json\n",
    "import logging\n",
    "from typing import Annotated, Dict, Any, List, Optional\n",
    "from typing_extensions import TypedDict\n",
    "from pydantic import BaseModel, Field\n",
    "\n",
    "from langchain_core.messages import BaseMessage, HumanMessage, SystemMessage\n",
    "from langchain_core.tools import tool\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "from langgraph.graph import StateGraph, START, END\n",
    "from langgraph.graph.message import add_messages\n",
    "from langgraph.prebuilt import ToolNode\n",
    "\n",
    "os.environ[\"GOOGLE_API_KEY\"] = "",
    "\n",
    "\n",
    "logging.basicConfig(level=logging.INFO, format=\"%(asctime)s [%(levelname)s] %(message)s\")\n",
    "logger = logging.getLogger(\"JobAlertAgent\")\n",
    "# -------------------------------------------------------------\n",
    "# 1. Mock Email Inbox (Simulating new unread emails)\n",
    "# -------------------------------------------------------------\n",
    "MOCK_INBOX = [\n",
    "    {\n",
    "        \"id\": \"email_01\",\n",
    "        \"sender\": \"recruiter@techcorp.io\",\n",
    "        \"subject\": \"Exciting Opportunity: Senior Python / AI Engineer\",\n",
    "        \"body\": \"Hi Santhosh, We came across your profile and loved your work. We are hiring a Senior AI Engineer at TechCorp (Remote, $140k-$160k). Apply here: https://techcorp.io/apply/123\",\n",
    "        \"is_read\": False\n",
    "    },\n",
    "    {\n",
    "        \"id\": \"email_02\",\n",
    "        \"sender\": \"newsletter@medium.com\",\n",
    "        \"subject\": \"Top 10 stories in tech today\",\n",
    "        \"body\": \"Here are your daily tech updates. Great job keeping up with programming trends! Check out these articles...\",\n",
    "        \"is_read\": False\n",
    "    },\n",
    "    {\n",
    "        \"id\": \"email_03\",\n",
    "        \"sender\": \"careers@google.com\",\n",
    "        \"subject\": \"Interview Invitation: Software Engineer\",\n",
    "        \"body\": \"Hello, we would like to invite you for an interview regarding the Software Engineer role at Google. Please pick a slot at: https://calendar.google.com/slots/456\",\n",
    "        \"is_read\": False\n",
    "    },\n",
    "    {\n",
    "        \"id\": \"email_04\",\n",
    "        \"sender\": \"careers@microsoft.com\",\n",
    "        \"subject\": \"Interview Invitation: Software Engineer\",\n",
    "        \"body\": \"Hello, we would like to invite you for an interview regarding the Software Engineer role at Google. Please pick a slot at: https://calendar.google.com/slots/456\",\n",
    "        \"is_read\": False\n",
    "    }\n",
    "]\n",
    "\n",
    "os.getenv(\"TELEGRAM_BOT_TOKEN\", "",
    "os.getenv(\"TELEGRAM_CHAT_ID\", ""),
    "\n",
    "@tool\n",
    "def fetch_unread_emails() -> List[Dict[str, Any]]:\n",
    "    \"\"\"Fetches all unread emails from the user's inbox.\"\"\"\n",
    "    unread = [email for email in MOCK_INBOX if not email[\"is_read\"]]\n",
    "    logger.info(f\"Retrieved {len(unread)} unread email(s).\")\n",
    "    return unread\n",
    "\n",
    "\n",
    "class TelegramAlertSchema(BaseModel):\n",
    "    company: str = Field(description=\"Name of the hiring company\")\n",
    "    role: str = Field(description=\"Job title / role\")\n",
    "    summary: str = Field(description=\"1-2 sentence summary of why this is relevant\")\n",
    "    action_link: Optional[str] = Field(default=None, description=\"Direct URL to apply or calendar link\")\n",
    "\n",
    "\n",
    "@tool(args_schema=TelegramAlertSchema)\n",
    "def send_telegram_alert(company: str, role: str, summary: str, action_link: Optional[str] = None) -> Dict[str, Any]:\n",
    "    \"\"\"Sends a formatted, instant notification to the user via Telegram when a relevant job email is found.\"\"\"\n",
    "    bot_token = os.getenv(\"TELEGRAM_BOT_TOKEN\")\n",
    "    chat_id = os.getenv(\"TELEGRAM_CHAT_ID\")\n",
    "    \n",
    "    if not bot_token or not chat_id:\n",
    "        return {\"status\": \"error\", \"message\": \"TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID environment variables are missing.\"}\n",
    "    \n",
    "    # Telegram supports clean Markdown formatting!\n",
    "    message_text = (\n",
    "        f\"🚨 *NEW JOB OPPORTUNITY DETECTED* 🚨\\n\\n\"\n",
    "        f\"🏢 *Company:* {company}\\n\"\n",
    "        f\"💼 *Role:* {role}\\n\"\n",
    "        f\"📝 *Summary:* {summary}\\n\"\n",
    "    )\n",
    "    if action_link:\n",
    "        message_text += f\"🔗 *Apply Here:* [Click to Open]({action_link})\"\n",
    "    url = f\"https://api.telegram.org/bot{bot_token}/sendMessage\"\n",
    "    payload = {\n",
    "        \"chat_id\": chat_id,\n",
    "        \"text\": message_text,\n",
    "        \"parse_mode\": \"Markdown\",\n",
    "        \"disable_web_page_preview\": False\n",
    "    }\n",
    "    try:\n",
    "        response = requests.post(url, json=payload, timeout=10)\n",
    "        data = response.json()\n",
    "        if data.get(\"ok\"):\n",
    "            print(f\"✅ Telegram alert delivered to chat {chat_id}!\")\n",
    "            return {\"status\": \"success\", \"message\": f\"Alert sent for {company}.\"}\n",
    "        else:\n",
    "            return {\"status\": \"error\", \"message\": f\"Telegram API error: {data.get('description')}\"}\n",
    "    except Exception as e:\n",
    "        return {\"status\": \"error\", \"message\": f\"Failed to send Telegram message: {str(e)}\"}\n",
    "\n",
    "\n",
    "@tool\n",
    "def mark_email_as_processed(email_id: str) -> Dict[str, Any]:\n",
    "    \"\"\"Marks an email as read/processed in the inbox so it is not analyzed again.\"\"\"\n",
    "    for email in MOCK_INBOX:\n",
    "        if email[\"id\"] == email_id:\n",
    "            email[\"is_read\"] = True\n",
    "            logger.info(f\"Marked email '{email_id}' as processed.\")\n",
    "            return {\"status\": \"success\", \"email_id\": email_id}\n",
    "    return {\"status\": \"error\", \"message\": f\"Email ID {email_id} not found.\"}\n",
    "tools = [fetch_unread_emails, send_whatsapp_alert, mark_email_as_processed]\n",
    "# -------------------------------------------------------------\n",
    "# 3. Agent State & System Instructions\n",
    "# -------------------------------------------------------------\n",
    "class AgentState(TypedDict):\n",
    "    messages: Annotated[List[BaseMessage], add_messages]\n",
    "SYSTEM_PROMPT = \"\"\"You are an autonomous Job Opportunity Watchdog Agent.\n",
    "Your job is to screen unread emails and immediately alert the user on WhatsApp if and only if an email is a genuine job opportunity, recruiter outreach, or interview invite.\n",
    "Your workflow:\n",
    "1. Call `fetch_unread_emails` to retrieve all unread emails.\n",
    "2. For each email:\n",
    "   - Carefully evaluate whether it is a real job posting or recruiter message.\n",
    "   - Ignore marketing newsletters, spam, and receipts (even if they contain words like 'job' or 'career').\n",
    "   - If it IS a job email:\n",
    "       * Call `send_whatsapp_alert` with phone number '+1234567890', extracting the company name, role, a concise summary, and any application/calendar link.\n",
    "   - Always call `mark_email_as_processed` for every email you inspect so it is not processed again.\n",
    "3. Once all emails are processed, provide a final concise report of actions taken.\n",
    "\"\"\"\n",
    "# -------------------------------------------------------------\n",
    "# 4. Build LangGraph Workflow\n",
    "# -------------------------------------------------------------\n",
    "llm = ChatGoogleGenerativeAI(\n",
    "    model=\"gemini-2.5-flash\",\n",
    "    temperature=0.0\n",
    ").bind_tools(tools)\n",
    "def agent_node(state: AgentState):\n",
    "    messages = [SystemMessage(content=SYSTEM_PROMPT)] + state[\"messages\"]\n",
    "    response = llm.invoke(messages)\n",
    "    return {\"messages\": [response]}\n",
    "tool_node = ToolNode(tools)\n",
    "def router(state: AgentState) -> str:\n",
    "    last_msg = state[\"messages\"][-1]\n",
    "    if hasattr(last_msg, \"tool_calls\") and len(last_msg.tool_calls) > 0:\n",
    "        return \"tools\"\n",
    "    return END\n",
    "builder = StateGraph(AgentState)\n",
    "builder.add_node(\"agent\", agent_node)\n",
    "builder.add_node(\"tools\", tool_node)\n",
    "builder.add_edge(START, \"agent\")\n",
    "builder.add_conditional_edges(\"agent\", router, {\"tools\": \"tools\", END: END})\n",
    "builder.add_edge(\"tools\", \"agent\")\n",
    "app = builder.compile()\n",
    "# -------------------------------------------------------------\n",
    "# 5. Execute the Agent\n",
    "# -------------------------------------------------------------\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"🤖 Starting Job Alert Watchdog...\\n\")\n",
    "    \n",
    "    # Notice: This prompt can be scheduled via a cron job every 15 minutes!\n",
    "    initial_prompt = \"Check inbox for any new emails, process them according to your instructions.\"\n",
    "    \n",
    "    inputs = {\"messages\": [HumanMessage(content=initial_prompt)]}\n",
    "    \n",
    "    for event in app.stream(inputs, stream_mode=\"values\"):\n",
    "        last_message = event[\"messages\"][-1]\n",
    "        if last_message.type == \"ai\" and not last_message.tool_calls:\n",
    "            print(\"\\n📋 Final Summary from Agent:\")\n",
    "            print(last_message.content)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
  }
 ],
